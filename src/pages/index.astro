---
import { getCollection } from 'astro:content';
import Dasar from '../layouts/Dasar.astro';
import Ubin from '../components/Ubin.astro';
import { bagian, tampil, ikuti } from '../bagian.js';

// Website publik menampilkan "Segera hadir" selama Beranda bertanda `sementara` (lihat bagian.js).
const penuh = import.meta.env.DEV || !bagian.find((b) => !b.slug).sementara;
const terbaru = tampil('tulisan')
  ? (await getCollection('tulisan')).sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()).slice(0, 3)
  : [];

// Isi contoh. Teks, foto, dan cuplikan karya yang asli masuk di tiket 07 dan 09.
const topik = [
  { nama: 'AI praktis', slug: 'tulisan', isi: 'Cara memakai AI untuk pekerjaan kantor sehari-hari, langkah demi langkah.' },
  { nama: 'Komunikasi dan presentasi', slug: 'tulisan', isi: 'Menulis, bercerita, dan menyampaikan gagasan supaya dipahami.' },
  { nama: 'Investasi', slug: 'investasi', isi: 'Jurnal perjalanan portofolio dan thesis per emiten, lengkap dengan sumber data.' },
];
const karya = [
  { nama: 'Data Masking Tool', guna: 'Menyamarkan data rahasia sebelum diolah AI, lalu mengembalikannya setelah selesai.' },
  { nama: 'Studio Lokal', guna: 'Dikte, subtitle, rekam layar, dan teleprompter yang berjalan di komputer sendiri.' },
  { nama: 'Konversi Laporan', guna: 'Mengubah laporan keuangan emiten menjadi teks ringkas yang hemat untuk dibaca AI.' },
];
---
{penuh ? (
  <Dasar judul="Alvin · AI praktis untuk pekerja kantor">
    <section class="pembuka">
      <div class="foto">Foto</div>
      <h1>AI praktis untuk pekerja kantor.</h1>
      <p>Halo, saya Alvin. Saya menulis langkah yang bisa langsung dicoba di meja kerja.</p>
      {ikuti.length > 0 && (
        <p class="aksi">
          {ikuti.map((s, i) => <a class:list={['pil', { polos: i > 0 }]} href={s.href}>{i ? s.nama : `Ikuti di ${s.nama}`}</a>)}
        </p>
      )}
    </section>
    {topik.every((t) => tampil(t.slug)) && (
      <section class="pita abu">
        <h2>Mulai dari mana?</h2>
        <div class="topik">
          {topik.map((t) => (
            <a href={`/${t.slug}/`}><h3>{t.nama}</h3><p>{t.isi}</p><span>Lihat tulisan</span></a>
          ))}
        </div>
      </section>
    )}
    {terbaru.length > 0 && (
      <section class="pita">
        <h2>Tulisan terbaru</h2>
        <Ubin daftar={terbaru} />
      </section>
    )}
    {tampil('karya') && (
      <section class="pita abu">
        <h2>Karya</h2>
        {karya.map((k) => (
          <a class="baris" href="/karya/">
            <div><h3>{k.nama}</h3><p>{k.guna}</p></div>
            <div class="gambar">Tangkapan layar</div>
          </a>
        ))}
      </section>
    )}
    {ikuti.length > 0 && (
      <section class="penutup">
        <h2>Ikuti tulisan harian saya</h2>
        {ikuti.map((s, i) => <a class:list={['pil', { polos: i > 0 }]} href={s.href}>{s.nama}</a>)}
      </section>
    )}
  </Dasar>
) : (
  <Dasar judul="Segera hadir">
    <section class="pembuka">
      <h1>Segera hadir</h1>
      <p>Website ini sedang disiapkan. Isinya menyusul.</p>
    </section>
  </Dasar>
)}
