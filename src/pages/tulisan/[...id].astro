---
// Satu file untuk daftar tulisan (/tulisan/) dan tiap halaman tulisan (/tulisan/<nama-file>/).
// Kalau bagian Tulisan belum tayang, tidak ada halaman yang dibangun.
import { getCollection, render } from 'astro:content';
import Dasar from '../../layouts/Dasar.astro';
import { tampil } from '../../bagian.js';

export async function getStaticPaths() {
  if (!tampil('tulisan')) return [];
  const daftar = (await getCollection('tulisan')).sort(
    (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf(),
  );
  return [
    { params: { id: undefined }, props: { daftar } },
    ...daftar.map((tulisan) => ({ params: { id: tulisan.id }, props: { tulisan } })),
  ];
}
const { daftar, tulisan } = Astro.props;
const { Content } = tulisan ? await render(tulisan) : {};
const formatTanggal = (tanggal) =>
  tanggal.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---
{tulisan ? (
  <Dasar judul={tulisan.data.judul}>
    <article>
      <h1>{tulisan.data.judul}</h1>
      <Content />
    </article>
  </Dasar>
) : (
  <Dasar judul="Tulisan">
    <h1>Tulisan</h1>
    <ul>
      {daftar.map((entri) => (
        <li>
          <a href={`/tulisan/${entri.id}/`}>{entri.data.judul}</a>
          <span> · {formatTanggal(entri.data.tanggal)} · {entri.data.kategori}</span>
        </li>
      ))}
    </ul>
  </Dasar>
)}
