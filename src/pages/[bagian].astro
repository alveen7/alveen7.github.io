---
// Halaman sementara untuk bagian yang belum punya isi sendiri.
// Bagian dengan `tampil: false` tidak dibangun sama sekali.
import Dasar from '../layouts/Dasar.astro';
import { bagian } from '../bagian.js';

export function getStaticPaths() {
  return bagian
    .filter((b) => b.tampil && ['tentang', 'karya', 'investasi'].includes(b.slug))
    .map((b) => ({ params: { bagian: b.slug }, props: { nama: b.nama } }));
}
const { nama } = Astro.props;
---
<Dasar judul={nama}>
  <h1>{nama}</h1>
  <p>Isi contoh. Bagian ini belum diisi.</p>
</Dasar>
